{
  "name": "readyscan",
  "version": "0.1.0",
  "description": "Audit a site's security headers and its readiness for AI crawlers — robots.txt, llms.txt, sitemap, AI crawler directives, markdown negotiation, and page metadata.",
  "keywords": [
    "security-headers",
    "http-headers",
    "csp",
    "hsts",
    "llms.txt",
    "llmstxt",
    "robots.txt",
    "ai-crawlers",
    "gptbot",
    "claudebot",
    "sitemap",
    "cli",
    "audit",
    "web-security"
  ],
  "license": "MIT",
  "author": "BlueDevLabs <contact@bluedevlabs.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueDevLabs/readyscan.git"
  },
  "bugs": {
    "url": "https://github.com/BlueDevLabs/readyscan/issues"
  },
  "homepage": "https://github.com/BlueDevLabs/readyscan#readme",
  "type": "module",
  "bin": {
    "readyscan": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "scan": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.0"
  }
}
